{
    "name": "rcalicdan/ramsey-collection-typephp-extension",
    "description": "Make Ramsey Collection enforce Reified generics",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rcalicdan\\RamseyExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "typephp/typephp": "^0.6",
        "ramsey/collection": "^2.1"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest"
        ]
    }
}

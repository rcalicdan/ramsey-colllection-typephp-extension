{
    "name" : "rcalicdan/ramsey-collection-typephp-extension",
    "description": "Make Ramsey Collection enforce Reiefied generics",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rcalicdan\\RamseyExtension\\": "src/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "typephp/typephp": "dev-main",
        "ramsey/collection": "^2.1"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
